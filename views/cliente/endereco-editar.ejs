<!DOCTYPE html>
<html lang="pt-BR">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Editar Endereço | VoieHaute</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">

    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/perfil.css">
</head>

<body>

    <%- include('partials/header') %>

        <main class="perfil-pagina">

            <div class="perfil-container">

                <!-- MENU LATERAL -->

                <aside class="perfil-menu">

                    <div class="perfil-menu-topo">
                        <img src="/uploads/logo.png" alt="VoieHaute">
                        <h2>MINHA CONTA</h2>
                    </div>

                    <nav class="perfil-links">

                        <a href="/perfil">
                            <i class="bi bi-person"></i>
                            Dados Pessoais
                        </a>

                        <a href="/perfil/enderecos" class="ativo">
                            <i class="bi bi-geo-alt"></i>
                            Endereços
                        </a>

                        <a href="/perfil/pedidos">
                            <i class="bi bi-box-seam"></i>
                            Pedidos
                        </a>

                        <a href="/favoritos">
                            <i class="bi bi-heart"></i>
                            Favoritos
                        </a>

                    </nav>


                    <div class="perfil-menu-inferior">
                        <img src="/uploads/pena.png" alt="" class="perfil-pena">

                        <div class="perfil-sair-area">
                            <button type="button" class="perfil-btn-sair" data-abrir-logout>
                                <i class="bi bi-box-arrow-right"></i>
                                Sair
                            </button>
                        </div>
                    </div>


                </aside>

                <!-- CONTEÚDO -->

                <section class="perfil-conteudo">

                    <div class="perfil-titulo">

                        <p>— ENDEREÇOS —</p>

                        <h1>Cadastre e Gerencie seus Endereços de Entrega</h1>

                        <div class="perfil-divisor">
                            <span>✦</span>
                        </div>

                    </div>

                    <!-- FORMULÁRIO DE EDIÇÃO -->

                    <form action="/perfil/enderecos/<%= endereco.id %>/editar" method="POST"
                        class="enderecos-formulario">

                        <!-- MENSAGEM DE ERRO -->

                        <% if (typeof erro !=='undefined' && erro) { %>
                            <div class="perfil-erro">
                                <%= erro %>
                            </div>
                            <% } %>

                                <!-- NOME E CPF -->

                                <div class="enderecos-linha">

                                    <div class="enderecos-campo">
                                        <label for="nome">Nome Completo</label>
                                        <input type="text" id="nome" name="nome" value="<%= endereco.nome %>" required>
                                    </div>

                                    <div class="enderecos-campo">
                                        <label for="cpf">CPF</label>
                                        <input type="text" id="cpf" name="cpf" value="<%= endereco.cpf %>"
                                            maxlength="14" required>
                                    </div>

                                </div>

                                <!-- CEP -->

                                <div class="enderecos-campo">
                                    <label for="cep">CEP</label>
                                    <input type="text" id="cep" name="cep" value="<%= endereco.cep %>" maxlength="9"
                                        required>
                                </div>

                                <!-- ENDEREÇO E NÚMERO -->

                                <div class="enderecos-linha endereco-numero">

                                    <div class="enderecos-campo">
                                        <label for="endereco">Endereço</label>
                                        <input type="text" id="endereco" name="endereco"
                                            value="<%= endereco.endereco %>" required>
                                    </div>

                                    <div class="enderecos-campo">
                                        <label for="numero">Número</label>
                                        <input type="text" id="numero" name="numero" value="<%= endereco.numero %>"
                                            required>
                                    </div>

                                </div>

                                <!-- COMPLEMENTO -->

                                <div class="enderecos-campo">
                                    <label for="complemento">
                                        Complemento (opcional)
                                    </label>
                                    <input type="text" id="complemento" name="complemento"
                                        value="<%= endereco.complemento || '' %>">
                                </div>

                                <!-- BAIRRO, CIDADE E ESTADO -->

                                <div class="enderecos-linha enderecos-tres-colunas">

                                    <div class="enderecos-campo">
                                        <label for="bairro">Bairro</label>
                                        <input type="text" id="bairro" name="bairro" value="<%= endereco.bairro %>"
                                            required>
                                    </div>

                                    <div class="enderecos-campo">
                                        <label for="cidade">Cidade</label>
                                        <input type="text" id="cidade" name="cidade" value="<%= endereco.cidade %>"
                                            required>
                                    </div>

                                    <div class="enderecos-campo">
                                        <label for="estado">Estado</label>
                                        <input type="text" id="estado" name="estado" value="<%= endereco.estado %>"
                                            maxlength="2" required>
                                    </div>

                                </div>

                                <!-- ENDEREÇO PRINCIPAL -->

                                <label class="enderecos-principal">

                                    <input type="checkbox" name="principal" value="1" <%=endereco.principal ? 'checked'
                                        : '' %>
                                    >

                                    <span>Salvar como principal</span>

                                </label>

                                <!-- BOTÕES -->

                                <div class="enderecos-editar-botoes">

                                    <a href="/perfil/enderecos" class="enderecos-cancelar">
                                        CANCELAR
                                    </a>

                                    <button type="submit" class="enderecos-salvar">
                                        SALVAR
                                    </button>

                                </div>

                    </form>

                </section>

            </div>

        </main>

        <%- include('partials/footer') %>
        <%- include('partials/modal-logout') %>

</body>

</html>