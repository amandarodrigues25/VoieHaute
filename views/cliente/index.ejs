<!DOCTYPE html>

<html lang="pt-BR">

<head>

    <meta charset="UTF-8">

    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>VoieHaute</title>


    <!-- BOOTSTRAP -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet">


    <!-- BOOTSTRAP ICONS -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">


    <!-- CSS -->
    <link rel="stylesheet" href="/css/style.css">

</head>


<body>


    <!-- HEADER -->
    <%- include('partials/header') %>


        <!-- CONTEÚDO DA HOME -->
        <main>
            <!-- =====================================================
     HERO / CARROSSEL DE BANNERS
     ===================================================== -->

            <section class="hero">

                <div class="hero-carrossel">

                    <!-- BANNER 1 -->
                    <div class="hero-slide ativo">
                        <a  class="hero-link">
                        <img src="/uploads/banner-poder-eterno.jpg" alt="O Poder do Eterno - VoieHaute"
                            class="hero-imagem"></a>
                    </div>

                    <!-- BANNER 2 -->
                    <div class="hero-slide">
                        <a href="/colecao/lheritage" class="hero-link">
                            <img src="/uploads/banner-coleção-branca.png" alt="Coleção Lumière - VoieHaute" class="hero-imagem">
                        </a>
                    </div>

                    <!-- BANNER 3 -->
                    <div class="hero-slide">
                        <a class="hero-link">
                            <img src="/uploads/banner-arte-criacao.jpg" alt="A Arte da Criação - VoieHaute" class="hero-imagem">
                        </a>
                    </div>
                            
                  

                    <!-- BANNER 4 -->
                    <div class="hero-slide">
                        <a class="hero-link">
                            <img src="/uploads/banner-luxo-consciente.jpg" alt="Luxo Consciente - VoieHaute" class="hero-imagem">
                        </a>
                    </div>

                    <!-- SETA ESQUERDA -->

                    <button class="hero-seta hero-seta-esquerda" type="button" onclick="mudarBanner(-1)"
                        aria-label="Banner anterior">
                        <i class="bi bi-chevron-left"></i>
                    </button>


                    <!-- SETA DIREITA -->

                    <button class="hero-seta hero-seta-direita" type="button" onclick="mudarBanner(1)"
                        aria-label="Próximo banner">
                        <i class="bi bi-chevron-right"></i>
                    </button>


                    <!-- BOLINHAS -->

                    <div class="hero-indicadores">

                        <button class="hero-indicador ativo" type="button" onclick="irParaBanner(0)"></button>

                        <button class="hero-indicador" type="button" onclick="irParaBanner(1)"></button>

                        <button class="hero-indicador" type="button" onclick="irParaBanner(2)"></button>

                        <button class="hero-indicador" type="button" onclick="irParaBanner(3)"></button>

                    </div>

                </div>

            </section>

            <!-- =====================================================
     EXPLORE POR CATEGORIA
     ===================================================== -->

            <section class="explorar-categorias">

                <div class="explorar-titulo">

                    <div class="explorar-subtitulo">
                        <span class="explorar-linha"></span>

                        <span class="explorar-subtitulo-texto">
                            NOVAS JOIAS
                        </span>

                        <span class="explorar-linha"></span>
                    </div>

                    <h2>Explore por categoria</h2>

                </div>
                <!-- CATEGORIAS -->
                <div class="explorar-filtros">

                    <button class="explorar-filtro ativo" type="button" data-categoria="Anéis"
                        data-banner="/uploads/categoria-aneis.png">
                        Anéis
                    </button>

                    <button class="explorar-filtro" type="button" data-categoria="Colares"
                        data-banner="/uploads/categoria-colares.png">
                        Colares
                    </button>

                    <button class="explorar-filtro" type="button" data-categoria="Pulseiras"
                        data-banner="/uploads/categoria-pulseiras.png">
                        Pulseiras
                    </button>

                    <button class="explorar-filtro" type="button" data-categoria="Brincos"
                        data-banner="/uploads/categoria-brincos.png">
                        Brincos
                    </button>

                    <button class="explorar-filtro" type="button" data-categoria="Tiaras"
                        data-banner="/uploads/categoria-tiaras.png">
                        Tiaras
                    </button>

                </div>


                <!-- BANNER + PRODUTOS -->
                <div class="explorar-conteudo">

                    <!-- BANNER DA CATEGORIA -->
                    <div class="explorar-banner">

                        <img id="bannerCategoria" src="/uploads/categoria-aneis.png" alt="Categoria Anéis">

                    </div>


                    <!-- PRODUTOS -->
                    <div class="explorar-produtos">

                        <% produtos.forEach(produto=> { %>

                            <article class="explorar-produto" data-id="<%= produto.id %>"
                                data-categoria="<%= produto.categoria %>">

                                <a href="/produto/<%= produto.id %>" class="explorar-produto-imagem">

                                    <img src="/uploads/<%= produto.imagem %>" alt="<%= produto.nome %>"
                                        class="produto-imagem-principal">

                                    <% if (produto.imagem_secundaria) { %>

                                        <img src="/uploads/<%= produto.imagem_secundaria %>" alt="<%= produto.nome %>"
                                            class="produto-imagem-secundaria">

                                        <% } %>

                                </a>

                                <div class="explorar-produto-info">

                                    <h3>
                                        <%= produto.nome %>
                                    </h3>

                                    <span>
                                        R$ <%= Number(produto.valor || 0).toLocaleString( 'pt-BR' , {
                                            minimumFractionDigits: 2, maximumFractionDigits: 2 } ) %>
                                    </span>

                                </div>

                            </article>

                            <% }) %>

                    </div>

                </div>

            </section>


            <!-- =====================================================
     NOVIDADES
     ===================================================== -->

            <section class="novidades">

                <div class="novidades-titulo">

                    <div class="novidades-subtitulo">
                        <span class="novidades-linha"></span>
                        <span>NOVIDADES</span>
                        <span class="novidades-linha"></span>
                    </div>

                    <h2>Novas Criações</h2>

                </div>

                <div class="novidades-carrossel">

                    <button class="novidades-seta novidades-seta-esquerda" type="button"
                        aria-label="Produtos anteriores">
                        ‹
                    </button>

                    <!-- JANELA QUE ESCONDE OS OUTROS CARDS -->
                    <div class="novidades-janela">

                        <div class="novidades-lista">

                            <% const novidadesIds=[4, 7, 17, 15, 27, 25]; const produtosNovidades=novidadesIds .map(id=>
                                produtos.find(produto => produto.id === id))
                                .filter(produto => produto);
                                %>

                                <% produtosNovidades.forEach(produto=> { %>

                                    <article class="novidade-card">

                                        <a href="/produto/<%= produto.id %>"
                                            class="novidade-imagem <%= produto.imagem_secundaria ? 'tem-secundaria' : '' %>">

                                            <img src="/uploads/<%= produto.imagem %>" alt="<%= produto.nome %>"
                                                class="novidade-imagem-principal">

                                            <% if (produto.imagem_secundaria) { %>

                                                <img src="/uploads/<%= produto.imagem_secundaria %>"
                                                    alt="<%= produto.nome %>" class="novidade-imagem-secundaria">

                                                <% } %>

                                        </a>

                                        <div class="novidade-info">

                                            <h3>
                                                <%= produto.nome %>
                                            </h3>

                                            <span>
                                                R$ <%= Number(produto.valor || 0).toLocaleString( 'pt-BR' , {
                                                    minimumFractionDigits: 2, maximumFractionDigits: 2 } ) %>
                                            </span>

                                        </div>

                                    </article>

                                    <% }) %>

                        </div>

                    </div>

                    <button class="novidades-seta novidades-seta-direita" type="button" aria-label="Próximos produtos">
                        ›
                    </button>

                </div>

            </section>
            <!-- =====================================================
     MAIS VENDIDAS
     ===================================================== -->

            <section class="mais-vendidas">

                <div class="mais-vendidas-titulo">

                    <div class="mais-vendidas-subtitulo">
                        <span class="mais-vendidas-linha"></span>
                        <span>MAIS VENDIDAS</span>
                        <span class="mais-vendidas-linha"></span>
                    </div>

                    <h2>As Favoritas da VoieHaute</h2>

                </div>

                <% const maisVendidasIds=[34, 20, 26, 17, 38]; const produtosMaisVendidos=maisVendidasIds .map(id=>
                    produtos.find(produto => produto.id === id))
                    .filter(produto => produto);
                    %>

                    <div class="mais-vendidas-lista">

                        <% produtosMaisVendidos.forEach(produto=> { %>

                            <article class="mais-vendida-card">

                                <!-- VÍDEO -->
                                <div class="mais-vendida-video">

                                    <% if (produto.video) { %>

                                        <video muted loop playsinline preload="metadata">
                                            <source src="/uploads/<%= produto.video %>" type="video/mp4">
                                        </video>

                                        <button class="mais-vendida-play" type="button" aria-label="Reproduzir vídeo">
                                            ▶
                                        </button>

                                        <% } else { %>

                                            <img src="/uploads/<%= produto.imagem %>" alt="<%= produto.nome %>"
                                                class="mais-vendida-sem-video">

                                            <% } %>

                                                <button class="mais-vendida-play" type="button"
                                                    aria-label="Reproduzir vídeo">
                                                    ▶
                                                </button>

                                </div>

                                <!-- INFORMAÇÕES -->
                                <a href="/produto/<%= produto.id %>" class="mais-vendida-info">

                                    <div class="mais-vendida-miniatura">

                                        <img src="/uploads/<%= produto.imagem %>" alt="<%= produto.nome %>">

                                    </div>

                                    <div class="mais-vendida-texto">

                                        <h3>
                                            <%= produto.nome %>
                                        </h3>

                                        <span>
                                            R$ <%= Number(produto.valor || 0).toLocaleString('pt-BR', {
                                                minimumFractionDigits: 2, maximumFractionDigits: 2 }) %>
                                        </span>

                                    </div>

                                </a>

                            </article>

                            <% }) %>

                    </div>

            </section>


            <!-- =====================================================
     OURO
     ===================================================== -->

            <section class="ouro">

                <div class="ouro-titulo">

                    <div class="ouro-subtitulo">
                        <span class="ouro-linha"></span>
                        <span>OURO</span>
                        <span class="ouro-linha"></span>
                    </div>

                    <h2>Brilho que permanece</h2>

                </div>

                <% const ouroIds=[17, 10, 22, 14, 9, 20, 12, 23, 16, 11, 19, 13, 21, 15, 18]; const produtosOuro=ouroIds
                    .map(id=> produtos.find(produto => produto.id === id))
                    .filter(produto => produto);
                    %>

                    <div class="ouro-carrossel">

                        <button class="ouro-seta ouro-seta-esquerda" type="button" aria-label="Produtos anteriores">
                            ‹
                        </button>

                        <div class="ouro-janela">

                            <div class="ouro-lista">

                                <% produtosOuro.forEach(produto=> { %>

                                    <article class="ouro-card">

                                        <a href="/produto/<%= produto.id %>"
                                            class="ouro-imagem <%= produto.imagem_secundaria ? 'tem-secundaria' : '' %>">

                                            <img src="/uploads/<%= produto.imagem %>" alt="<%= produto.nome %>"
                                                class="ouro-imagem-principal">

                                            <% if (produto.imagem_secundaria) { %>

                                                <img src="/uploads/<%= produto.imagem_secundaria %>"
                                                    alt="<%= produto.nome %>" class="ouro-imagem-secundaria">

                                                <% } %>

                                        </a>

                                        <div class="ouro-info">

                                            <h3>
                                                <%= produto.nome %>
                                            </h3>

                                            <span>
                                                R$ <%= Number(produto.valor || 0).toLocaleString( 'pt-BR' , {
                                                    minimumFractionDigits: 2, maximumFractionDigits: 2 } ) %>
                                            </span>

                                        </div>

                                    </article>

                                    <% }) %>

                            </div>

                        </div>

                        <button class="ouro-seta ouro-seta-direita" type="button" aria-label="Próximos produtos">
                            ›
                        </button>

                    </div>

            </section>

            <!-- =====================================================
     EXPERIÊNCIA VOIEHAUTE
     ===================================================== -->

            <section class="experiencia">

                <div class="experiencia-titulo">

                    <div class="experiencia-subtitulo">
                        <span class="experiencia-linha"></span>
                        <span>EXPERIÊNCIA VOIEHAUTE</span>
                        <span class="experiencia-linha"></span>
                    </div>

                    <h2>Cada Detalhe Importa</h2>

                </div>

                <div class="experiencia-itens">

                    <!-- EMBALAGENS -->
                    <article class="experiencia-item">

                        <div class="experiencia-icone">
                            <img src="/uploads/gift.png" alt="Embalagens exclusivas">
                        </div>

                        <h3>EMBALAGENS EXCLUSIVAS</h3>

                        <p>
                            Cada joia é preparada para tornar<br>
                            sua experiência inesquecível
                        </p>

                        <span class="experiencia-detalhe"></span>

                    </article>

                    <!-- ENTREGA -->
                    <article class="experiencia-item">

                        <div class="experiencia-icone">
                            <img src="/uploads/express-delivery.png" alt="Entrega segura">
                        </div>

                        <h3>ENTREGA SEGURA</h3>

                        <p>
                            Cuidado especial em cada envio, com<br>
                            rastreamento e embalagem reforçada
                        </p>

                        <span class="experiencia-detalhe"></span>

                    </article>

                    <!-- AUTENTICIDADE -->
                    <article class="experiencia-item">

                        <div class="experiencia-icone">
                            <img src="/uploads/joias.png" alt="Autenticidade">
                        </div>

                        <h3>AUTENTICIDADE</h3>

                        <p>
                            Materiais e pedras selecionadas<br>
                            com rigor e qualidade
                        </p>

                        <span class="experiencia-detalhe"></span>

                    </article>

                    <!-- ATENDIMENTO -->
                    <article class="experiencia-item">

                        <div class="experiencia-icone">
                            <img src="/uploads/fone-de-ouvido.png" alt="Atendimento privado">
                        </div>

                        <h3>ATENDIMENTO PRIVADO</h3>

                        <p>
                            Uma experiência dedicada a cada cliente,<br>
                            com suporte personalizado
                        </p>

                        <span class="experiencia-detalhe"></span>

                    </article>

                </div>

            </section>

        </main>


        <!-- FOOTER -->
        <%- include('partials/footer') %>

            <script>
                let bannerAtual = 0;

                const banners = document.querySelectorAll('.hero-slide');
                const indicadores = document.querySelectorAll('.hero-indicador');


                function mostrarBanner(indice) {

                    if (indice >= banners.length) {
                        bannerAtual = 0;
                    } else if (indice < 0) {
                        bannerAtual = banners.length - 1;
                    } else {
                        bannerAtual = indice;
                    }


                    banners.forEach((banner) => {
                        banner.classList.remove('ativo');
                    });


                    indicadores.forEach((indicador) => {
                        indicador.classList.remove('ativo');
                    });


                    banners[bannerAtual].classList.add('ativo');

                    indicadores[bannerAtual].classList.add('ativo');
                }


                function mudarBanner(direcao) {
                    mostrarBanner(bannerAtual + direcao);
                }


                function irParaBanner(indice) {
                    mostrarBanner(indice);
                }


                /* TROCA AUTOMÁTICA */

                setInterval(() => {
                    mudarBanner(1);
                }, 6000);



                /* =====================================================
                 EXPLORE POR CATEGORIA
                ===================================================== */

                const filtrosCategoria =
                    document.querySelectorAll('.explorar-filtro');

                const produtosCategoria =
                    document.querySelectorAll('.explorar-produto');

                const bannerCategoria =
                    document.getElementById('bannerCategoria');

                const produtosEscolhidos = {
                    "Anéis": [14, 34],
                    "Colares": [25, 15],
                    "Pulseiras": [12, 7],
                    "Brincos": [31, 16],
                    "Tiaras": [23, 18]
                };


                function trocarCategoria(botao) {

                    const categoria = botao.dataset.categoria;
                    const banner = botao.dataset.banner;


                    /* TROCA O BOTÃO ATIVO */

                    filtrosCategoria.forEach((filtro) => {
                        filtro.classList.remove('ativo');
                    });

                    botao.classList.add('ativo');


                    /* TROCA O BANNER */

                    bannerCategoria.src = banner;
                    bannerCategoria.alt = 'Categoria ' + categoria;


                    /* TROCA OS PRODUTOS */

                    const idsEscolhidos = produtosEscolhidos[categoria];

                    produtosCategoria.forEach((produto) => {

                        produto.classList.remove('mostrar');

                        const idProduto = Number(produto.dataset.id);

                        if (idsEscolhidos.includes(idProduto)) {
                            produto.classList.add('mostrar');
                        }

                    });
                }


                filtrosCategoria.forEach((botao) => {
                    botao.addEventListener('click', () => {
                        trocarCategoria(botao);
                    });
                });


                /* COMEÇA EM ANÉIS */

                trocarCategoria(
                    document.querySelector('.explorar-filtro.ativo')
                );


                /* =====================================================
                 CARROSSEL - NOVIDADES
                ===================================================== */

                const novidadesLista = document.querySelector('.novidades-lista');
                const novidadesCards = document.querySelectorAll('.novidade-card');
                const novidadesAnterior = document.querySelector('.novidades-seta-esquerda');
                const novidadesProximo = document.querySelector('.novidades-seta-direita');

                let novidadeAtual = 0;

                function moverNovidades() {

                    if (!novidadesCards.length) return;

                    const larguraCard = novidadesCards[0].offsetWidth;
                    const gap = 18;

                    novidadesLista.style.transform =
                        `translateX(-${novidadeAtual * (larguraCard + gap)}px)`;
                }

                novidadesProximo.addEventListener('click', () => {

                    const maximo = Math.max(0, novidadesCards.length - 4);

                    if (novidadeAtual < maximo) {
                        novidadeAtual++;
                    } else {
                        novidadeAtual = 0;
                    }

                    moverNovidades();
                });

                novidadesAnterior.addEventListener('click', () => {

                    const maximo = Math.max(0, novidadesCards.length - 4);

                    if (novidadeAtual > 0) {
                        novidadeAtual--;
                    } else {
                        novidadeAtual = maximo;
                    }

                    moverNovidades();
                });
                /* =====================================================
                   VÍDEOS - MAIS VENDIDAS
                   ===================================================== */

                document.querySelectorAll('.mais-vendida-card').forEach(card => {
                    const video = card.querySelector('video');
                    const play = card.querySelector('.mais-vendida-play');

                    if (!video) return;

                    card.addEventListener('mouseenter', () => {
                        video.play();

                        if (play) {
                            play.style.display = 'none';
                        }
                    });

                    card.addEventListener('mouseleave', () => {
                        video.pause();
                        video.currentTime = 0;

                        if (play) {
                            play.style.display = 'flex';
                        }
                    });
                });


                /* =====================================================
    CARROSSEL - OURO
    ===================================================== */

                const ouroLista = document.querySelector('.ouro-lista');
                const ouroCards = document.querySelectorAll('.ouro-card');
                const ouroAnterior = document.querySelector('.ouro-seta-esquerda');
                const ouroProximo = document.querySelector('.ouro-seta-direita');

                let ouroAtual = 0;
                const ouroVisiveis = 4;

                function moverOuro() {
                    if (!ouroCards.length) return;

                    const larguraCard = ouroCards[0].getBoundingClientRect().width;
                    const gap = 18;

                    const deslocamento = ouroAtual * (larguraCard + gap);

                    ouroLista.style.transform = `translateX(-${deslocamento}px)`;
                }

                ouroProximo.addEventListener('click', () => {

                    const maximo = Math.max(
                        0,
                        ouroCards.length - ouroVisiveis
                    );

                    if (ouroAtual < maximo) {
                        ouroAtual++;
                    } else {
                        ouroAtual = 0;
                    }

                    moverOuro();
                });

                ouroAnterior.addEventListener('click', () => {

                    const maximo = Math.max(
                        0,
                        ouroCards.length - ouroVisiveis
                    );

                    if (ouroAtual > 0) {
                        ouroAtual--;
                    } else {
                        ouroAtual = maximo;
                    }

                    moverOuro();
                });
            </script>


</body>

</html>