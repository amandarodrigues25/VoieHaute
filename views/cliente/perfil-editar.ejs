<!DOCTYPE html>
<html lang="pt-BR">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Editar Dados Pessoais | VoieHaute</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet">

    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">

    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/perfil.css">
</head>

<body>

    <%- include('partials/header') %>

        <main class="perfil-pagina">

            <div class="perfil-container">

                <!-- =====================================
                 MENU LATERAL
            ====================================== -->

                <aside class="perfil-menu">

                    <div class="perfil-menu-topo">
                        <img src="/uploads/logo.png" alt="VoieHaute">
                        <h2>MINHA CONTA</h2>
                    </div>

                    <nav class="perfil-links">

                        <a href="/perfil" class="ativo">
                            <i class="bi bi-person"></i>
                            Dados Pessoais
                        </a>

                        <a href="/perfil/enderecos">
                            <i class="bi bi-geo-alt"></i>
                            Endereços
                        </a>

                        <a href="/perfil/pedidos">
                            <i class="bi bi-box-seam"></i>
                            Pedidos
                        </a>

                        <a href="/favoritos">
                            <i class="bi bi-heart"></i>
                            Favoritos
                        </a>

                    </nav>


                    <div class="perfil-menu-inferior">
                        <img src="/uploads/pena.png" alt="" class="perfil-pena">

                        <div class="perfil-sair-area">
                            <button type="button" class="perfil-btn-sair" data-abrir-logout>
                                <i class="bi bi-box-arrow-right"></i>
                                Sair
                            </button>
                        </div>
                    </div>


                </aside>

                <!-- =====================================
                 CONTEÚDO PRINCIPAL
            ====================================== -->

                <section class="perfil-conteudo">

                    <div class="perfil-titulo">

                        <p>— DADOS PESSOAIS —</p>

                        <h1>Editar Dados Pessoais</h1>

                        <div class="perfil-divisor">
                            <span>✦</span>
                        </div>

                    </div>

                    <!-- =====================================
                     CARD DE EDIÇÃO
                ====================================== -->

                    <div class="perfil-card">

                        <form action="/perfil/editar" method="POST" enctype="multipart/form-data"
                            class="perfil-formulario-completo">

                            <!-- FOTO DE PERFIL -->

                            <div class="perfil-avatar">

                                <div class="perfil-avatar-circulo">

                                    <% if (cliente.foto) { %>

                                        <img id="preview-foto" src="<%= cliente.foto %>" alt="Foto de perfil">

                                        <i id="icone-avatar" class="bi bi-person foto-oculta"></i>

                                        <% } else { %>

                                            <img id="preview-foto" alt="Foto de perfil" class="foto-oculta">

                                            <i id="icone-avatar" class="bi bi-person"></i>

                                            <% } %>

                                </div>

                                <!-- BOTÃO DO LÁPIS -->

                                <label for="foto-perfil" class="perfil-botao-foto" title="Alterar foto de perfil">
                                    <i class="bi bi-pencil"></i>
                                </label>

                                <!-- UPLOAD -->

                                <input type="file" id="foto-perfil" name="foto" accept="image/png,image/jpeg,image/webp"
                                    hidden>

                            </div>

                            <!-- =====================================
                             DADOS PESSOAIS
                        ====================================== -->

                            <div class="perfil-dados">

                                <!-- MENSAGEM DE ERRO -->

                                <% if (erro) { %>

                                    <div class="perfil-erro">
                                        <%= erro %>
                                    </div>

                                    <% } %>

                                        <!-- NOME COMPLETO -->

                                        <div class="perfil-campo">

                                            <label for="nome">
                                                Nome completo
                                            </label>

                                            <input type="text" id="nome" name="nome" value="<%= cliente.nome || '' %>"
                                                autocomplete="name" required>

                                        </div>

                                        <!-- EMAIL E TELEFONE -->

                                        <div class="perfil-linha">

                                            <div class="perfil-campo">

                                                <label for="email">
                                                    Email
                                                </label>

                                                <input type="email" id="email" name="email"
                                                    value="<%= cliente.email || '' %>" autocomplete="email" required>

                                            </div>

                                            <div class="perfil-campo">

                                                <label for="telefone">
                                                    Telefone
                                                </label>

                                                <input type="tel" id="telefone" name="telefone"
                                                    value="<%= cliente.telefone || '' %>" autocomplete="tel" required>

                                            </div>

                                        </div>

                                        <!-- NASCIMENTO E CPF -->

                                        <div class="perfil-linha">

                                            <div class="perfil-campo">

                                                <label for="nascimento">
                                                    Data de nascimento
                                                </label>

                                                <input type="date" id="nascimento" name="nascimento"
                                                    value="<%= cliente.nascimento || '' %>" required>

                                            </div>

                                            <div class="perfil-campo">

                                                <label for="cpf">
                                                    CPF
                                                </label>

                                                <input type="text" id="cpf" name="cpf" value="<%= cliente.cpf || '' %>"
                                                    maxlength="14" inputmode="numeric" required>

                                            </div>

                                        </div>

                                        <!-- =====================================
                                 BOTÕES
                            ====================================== -->

                                        <div class="perfil-acoes-edicao">

                                            <a href="/perfil" class="perfil-cancelar">
                                                CANCELAR
                                            </a>

                                            <button type="submit" class="perfil-salvar">
                                                SALVAR
                                            </button>

                                        </div>

                            </div>

                        </form>

                    </div>

                </section>

            </div>

        </main>

        <%- include('partials/footer') %>
        <%- include('partials/modal-logout') %>

            <!-- =====================================
         PRÉ-VISUALIZAÇÃO DA FOTO
    ====================================== -->

            <script>

                const inputFoto = document.getElementById('foto-perfil');
                const preview = document.getElementById('preview-foto');
                const icone = document.getElementById('icone-avatar');

                inputFoto.addEventListener('change', function () {

                    const arquivo = this.files[0];

                    if (!arquivo) {
                        return;
                    }

                    const formatosPermitidos = [
                        'image/jpeg',
                        'image/png',
                        'image/webp'
                    ];

                    if (!formatosPermitidos.includes(arquivo.type)) {
                        alert('Escolha uma imagem JPG, PNG ou WEBP.');
                        this.value = '';
                        return;
                    }

                    const tamanhoMaximo = 3 * 1024 * 1024;

                    if (arquivo.size > tamanhoMaximo) {
                        alert('A imagem deve ter no máximo 3 MB.');
                        this.value = '';
                        return;
                    }

                    if (preview.dataset.url) {
                        URL.revokeObjectURL(preview.dataset.url);
                    }

                    const url = URL.createObjectURL(arquivo);

                    preview.src = url;
                    preview.dataset.url = url;

                    preview.classList.remove('foto-oculta');
                    preview.style.display = 'block';

                    if (icone) {
                        icone.classList.add('foto-oculta');
                    }

                });

            </script>

</body>

</html>