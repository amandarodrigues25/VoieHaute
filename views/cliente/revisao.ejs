
<!DOCTYPE html>
<html lang="pt-BR">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Revisão do Pedido | VoieHaute</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css">
</head>

<body class="pagina-entrega pagina-revisao">

    <%- include('./partials/header') %>

    <main class="entrega-pagina">

        <!-- ETAPAS -->

        <nav class="entrega-etapas" aria-label="Etapas da compra">

            <div class="entrega-etapa">
                <span>1</span> Sacola
            </div>

            <div class="entrega-etapa">
                <span>2</span> Entrega
            </div>

            <div class="entrega-etapa">
                <span>3</span> Pagamento
            </div>

            <div class="entrega-etapa ativa">
                <span>4</span> Revisão
            </div>

        </nav>

        <!-- TÍTULO -->

        <header class="entrega-cabecalho">

            <div class="entrega-eyebrow">
                <span></span>
                SUA REVISÃO
                <span></span>
            </div>

            <h1>Revise seu Pedido</h1>

            <p>Confira todos os detalhes antes de finalizar</p>

        </header>

        <div class="entrega-layout revisao-layout">

            <!-- COLUNA ESQUERDA -->

            <section class="revisao-conteudo">

                <div class="revisao-informacoes">

                    <!-- ENDEREÇO -->

                    <section class="revisao-bloco">

                        <div class="revisao-bloco-cabecalho">

                            <i class="bi bi-truck revisao-icone"></i>

                            <h2>ENDEREÇO DE ENTREGA</h2>

                        </div>

                        <div class="revisao-bloco-corpo">

                            <div class="revisao-dados">

                                <p class="revisao-nome">
                                    <%= endereco.nome %>
                                </p>

                                <p>
                                    <%= endereco.endereco %>,
                                    <%= endereco.numero %>
                                </p>

                                <% if (endereco.complemento) { %>
                                    <p><%= endereco.complemento %></p>
                                <% } %>

                                <p><%= endereco.bairro %></p>

                                <p>
                                    <%= endereco.cidade %> -
                                    <%= endereco.estado %>
                                </p>

                                <p><%= endereco.cep %></p>

                            </div>

                            <a href="/carrinho/entrega?editar=1"
                               class="revisao-editar">
                                Editar
                            </a>

                        </div>

                    </section>

                    <!-- PAGAMENTO -->

                    <section class="revisao-bloco">

                        <div class="revisao-bloco-cabecalho">

                            <i class="bi bi-credit-card-2-front revisao-icone"></i>

                            <h2>FORMA DE PAGAMENTO</h2>

                        </div>

                        <div class="revisao-bloco-corpo">

                            <div class="revisao-dados">

                                <% if (pagamento.metodo === 'cartao') { %>

                                    <p>Cartão de crédito</p>

                                    <p>Pagamento demonstrativo</p>

                                    <p>
                                        <%= pagamento.parcelas %>x de
                                        <%= (total / pagamento.parcelas).toLocaleString(
                                            'pt-BR',
                                            {
                                                style: 'currency',
                                                currency: 'BRL'
                                            }
                                        ) %>
                                        (sem juros)
                                    </p>

                                <% } else { %>

                                    <p>Pix</p>

                                    <p>Pagamento à vista</p>

                                    <p>
                                        <%= total.toLocaleString('pt-BR', {
                                            style: 'currency',
                                            currency: 'BRL'
                                        }) %>
                                    </p>

                                <% } %>

                            </div>

                            <a href="/carrinho/pagamento"
                               class="revisao-editar">
                                Editar
                            </a>

                        </div>

                    </section>

                </div>

                <!-- FINALIZAR -->

                <form action="/carrinho/revisao/finalizar"
                      method="POST"
                      class="revisao-form-finalizar">

                    <button type="submit"
                            class="revisao-botao-finalizar">
                        FINALIZAR PEDIDO
                    </button>

                </form>

            </section>

            <!-- RESUMO DO PEDIDO -->

            <aside class="entrega-resumo">

                <div class="entrega-resumo-cabecalho">

                    <h2>RESUMO DO PEDIDO</h2>

                    <a href="/carrinho">editar sacola</a>

                </div>

                <div class="entrega-resumo-produtos">

                    <% itens.forEach(item => { %>

                        <div class="entrega-resumo-produto">

                            <img
                                src="<%= item.produto.imagem
                                    ? (item.produto.imagem.startsWith('/')
                                        ? item.produto.imagem
                                        : '/uploads/' + item.produto.imagem)
                                    : '/uploads/sem-imagem.png' %>"
                                alt="<%= item.produto.nome %>">

                            <div class="entrega-resumo-info">

                                <h3><%= item.produto.nome %></h3>

                                <strong>
                                    <%= item.subtotal.toLocaleString(
                                        'pt-BR',
                                        {
                                            style: 'currency',
                                            currency: 'BRL'
                                        }
                                    ) %>
                                </strong>

                                <p>QAT: <%= item.quantidade %></p>

                            </div>

                        </div>

                    <% }) %>

                </div>

                <div class="entrega-resumo-valores">

                    <div>
                        <span>Subtotal</span>

                        <span>
                            <%= total.toLocaleString('pt-BR', {
                                style: 'currency',
                                currency: 'BRL'
                            }) %>
                        </span>
                    </div>

                    <div>
                        <span>Frete</span>
                        <span>Grátis</span>
                    </div>

                </div>

                <div class="entrega-resumo-total">

                    <span>Total</span>

                    <strong>
                        <%= total.toLocaleString('pt-BR', {
                            style: 'currency',
                            currency: 'BRL'
                        }) %>
                    </strong>

                </div>

            </aside>

        </div>

    </main>

    <%- include('./partials/footer') %>

</body>
</html>
