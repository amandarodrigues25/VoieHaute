<!DOCTYPE html>
<html lang="pt-BR">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>La Maison | VoieHaute</title>

    <link rel="stylesheet" href="/css/style.css">
</head>

<body>

    <%- include('partials/header') %>

        <main class="maison">

            <!-- =================================================
             HERO
        ================================================== -->

            <section class="maison-hero">

                <img src="/uploads/maison-hero.png" alt="La Maison VoieHaute">

            </section>


            <!-- =================================================
             HISTÓRIA
        ================================================== -->

            <section class="maison-historia">

                <div class="maison-historia-cabecalho">

                    <div class="maison-eyebrow">
                        <span></span>
                        <p>NOSSA HISTÓRIA</p>
                        <span></span>
                    </div>

                    <h2>Uma História Criada Para Permanecer</h2>

                    <p>
                        A trajetória da VoieHaute é construída por momentos que
                        transformaram uma visão de alta joalheria em uma maison
                        marcada por tradição, raridade e excelência.
                    </p>

                </div>


                <!-- =================================================
                 TIMELINE FIXA
            ================================================== -->

                <div class="maison-timeline-wrapper">

                    <div class="maison-timeline">

                        <div class="maison-timeline-linha"></div>

                        <button class="maison-ano" data-ano="2016">
                            <i class="maison-estrela">✦</i>
                            <span>2016</span>
                        </button>

                        <button class="maison-ano" data-ano="2018">
                            <i class="maison-estrela">✦</i>
                            <span>2018</span>
                        </button>

                        <button class="maison-ano" data-ano="2021">
                            <i class="maison-estrela">✦</i>
                            <span>2021</span>
                        </button>

                        <button class="maison-ano" data-ano="2024">
                            <i class="maison-estrela">✦</i>
                            <span>2024</span>
                        </button>

                        <button class="maison-ano" data-ano="2026">
                            <i class="maison-estrela">✦</i>
                            <span>2026</span>
                        </button>

                    </div>

                </div>


                <!-- =================================================
                 2016
            ================================================== -->

                <section class="maison-marco maison-marco-2016" data-ano="2016">

                    <div class="maison-marco-cabecalho">

                        <div class="maison-marco-ano">
                            <span></span>
                            <p>2016</p>
                            <span></span>
                        </div>

                        <h2>O INÍCIO</h2>

                        <h3>NASCE A VOIEHAUTE</h3>

                        <div class="maison-marco-texto">
                            <p>
                                A VoieHaute nasce do desejo de criar joias que ultrapassem a beleza do instante e
                                adquiram significado ao longo do tempo. Inspirada pela tradição da alta joalheria e pela
                                elegância de grandes criações atemporais, a Maison começa a construir uma identidade
                                baseada na exclusividade, na delicadeza dos detalhes e na busca constante pelo
                                extraordinário.
                            </p>

                            <p>
                                Desde suas primeiras criações, cada joia é pensada não apenas como um objeto precioso,
                                mas como uma peça capaz de guardar memórias e acompanhar diferentes gerações. É nesse
                                princípio que surge a essência da VoieHaute: unir beleza, emoção e permanência em
                                criações feitas para se tornarem verdadeiros legados.
                            </p>
                        </div>

                    </div>

                    <div class="maison-marco-imagem">
                        <img src="/uploads/maison-inicio.png" alt="O início da VoieHaute">
                    </div>

                </section>


                <!-- =================================================
                 2018
            ================================================== -->

                <section class="maison-marco" data-ano="2018">

                    <div class="maison-marco-cabecalho">

                        <div class="maison-marco-ano">
                            <span></span>
                            <p>2018</p>
                            <span></span>
                        </div>

                        <h2>UMA IDENTIDADE GANHA FORMA</h2>

                        <h3>OS PRIMEIROS TRAÇOS</h3>

                        <div class="maison-marco-texto">

                            <p>
                                Com o amadurecimento de sua identidade, a VoieHaute passa a desenvolver uma linguagem
                                criativa cada vez mais própria. Arte, arquitetura, natureza, lugares e diferentes
                                períodos históricos tornam-se pontos de partida para coleções que transformam
                                referências e emoções em formas, volumes e cores.
                            </p>

                            <p>
                                O desenho à mão assume um papel central nesse processo. Cada criação começa com
                                pesquisas, referências e inúmeros croquis até encontrar o equilíbrio entre proporção,
                                movimento e presença. Aos poucos, as joias passam a revelar uma assinatura reconhecível:
                                composições marcantes, pedras excepcionais e uma atenção minuciosa aos detalhes.
                            </p>

                            <p>
                                É quando cada coleção deixa de representar apenas um conjunto de peças e passa a contar
                                uma história própria.
                            </p>

                        </div>

                    </div>

                    <div class="maison-marco-imagem">
                        <img src="/uploads/maison-identidade.png" alt="Uma identidade ganha forma">
                    </div>

                </section>


                <!-- =================================================
                 2021
            ================================================== -->

                <section class="maison-marco" data-ano="2021">

                    <div class="maison-marco-cabecalho">

                        <div class="maison-marco-ano">
                            <span></span>
                            <p>2021</p>
                            <span></span>
                        </div>

                        <h2>A RARIDADE COMO ASSINATURA</h2>

                        <h3>PEDRAS EXTRAORDINÁRIAS</h3>

                        <div class="maison-marco-texto">

                            <p>
                                A busca pelo extraordinário conduz a Maison a uma seleção ainda mais criteriosa de seus
                                materiais. A pedra preciosa deixa de ser apenas um elemento da criação e passa a ocupar
                                o centro de muitas das histórias contadas pela VoieHaute.
                            </p>

                            <p>
                                Diamantes luminosos, Rubis Pigeon Blood, Esmeraldas Colombianas, Safiras Padparadscha,
                                Turmalinas Paraíba, Tanzanitas e raros diamantes coloridos são escolhidos por
                                características capazes de tornar cada criação singular. Cor, transparência, lapidação,
                                proporção e raridade passam a orientar essa seleção.
                            </p>

                            <p>
                                Ao lado das gemas, Ouro Amarelo 18k, Ouro Branco 18k, Ouro Rosé 18k e Platina 950 dão
                                estrutura às criações. É desse encontro entre matéria, técnica e imaginação que nasce
                                uma das principais assinaturas da Maison: joias em que cada material possui uma razão
                                para estar presente.
                            </p>

                        </div>

                    </div>

                    <div class="maison-marco-imagem">
                        <img src="/uploads/maison-raridade.png" alt="A raridade como assinatura">
                    </div>

                </section>


                <!-- =================================================
                 2024
            ================================================== -->

                <section class="maison-marco" data-ano="2024">

                    <div class="maison-marco-cabecalho">

                        <div class="maison-marco-ano">
                            <span></span>
                            <p>2024</p>
                            <span></span>
                        </div>

                        <h2>UM NOVO OLHAR PARA O LUXO</h2>

                        <h3>BELEZA COM PROPÓSITO</h3>

                        <div class="maison-marco-texto">

                            <p>
                                Com o passar dos anos, a VoieHaute amplia sua compreensão sobre o significado do luxo. A
                                excelência continua essencial, mas passa a caminhar ao lado de uma preocupação maior com
                                a origem dos materiais, a valorização do trabalho artesanal e as escolhas realizadas em
                                cada etapa da criação.
                            </p>

                            <p>
                                A Maison fortalece a seleção criteriosa de fornecedores e passa a olhar para todo o
                                ciclo de suas peças — desde a escolha das matérias-primas até a forma como cada joia
                                chega às mãos de quem irá carregá-la. Embalagens duráveis, processos cuidadosos e a
                                redução de excessos tornam-se parte dessa evolução.
                            </p>

                            <p>
                                Para a VoieHaute, criar algo destinado a atravessar gerações também significa pensar
                                além do presente. Assim, tradição, qualidade e responsabilidade passam a construir uma
                                visão de luxo mais consciente e duradoura.
                            </p>

                        </div>

                    </div>

                    <div class="maison-marco-imagem">
                        <img src="/uploads/maison-luxo.png" alt="Um novo olhar para o luxo">
                    </div>

                </section>


                <!-- =================================================
                 2026
            ================================================== -->

                <section class="maison-marco" data-ano="2026">

                    <div class="maison-marco-cabecalho">

                        <div class="maison-marco-ano">
                            <span></span>
                            <p>2026</p>
                            <span></span>
                        </div>

                        <h2>O LEGADO CONTINUA</h2>

                        <h3>UMA MAISON EM CONSTANTE CRIAÇÃO</h3>

                        <div class="maison-marco-texto">

                            <p>
                                Hoje, a VoieHaute reúne tudo aquilo que construiu ao longo de sua trajetória: a tradição
                                da alta joalheria, a liberdade da criação contemporânea, a raridade das pedras preciosas
                                e o cuidado de um trabalho pensado nos mínimos detalhes.
                            </p>

                            <p>
                                Suas coleções exploram universos distintos — da força das cortes e dos jardins reais à
                                primeira luz do amanhecer, às águas brasileiras e à imensidão da galáxia. Cada
                                inspiração ganha uma identidade própria, mas todas carregam a mesma essência: criar algo
                                excepcional, reconhecível e capaz de permanecer.
                            </p>

                            <p>
                                A história da VoieHaute, porém, não termina em uma coleção ou em uma joia. Ela continua
                                em cada criação e nas histórias que essas peças ainda irão acompanhar.
                            </p>

                            <p>
                                Mais que joias, criamos legados para sempre.
                            </p>

                        </div>

                    </div>

                    <div class="maison-marco-imagem">
                        <img src="/uploads/maison-legado.png" alt="O legado continua">
                    </div>

                </section>

                <!-- =================================================
     DO PRIMEIRO TRAÇO À JOIA
================================================== -->

                <section class="maison-savoir">

                    <div class="maison-savoir-cabecalho">

                        <div class="maison-savoir-eyebrow">
                            <span></span>
                            <p>LE SAVOIR-FAIRE</p>
                            <span></span>
                        </div>

                        <h2>Do Primeiro Traço À Joia</h2>

                        <p>
                            Cada criação VoieHaute percorre um caminho onde inspiração,
                            desenho, raridade e savoir-faire se encontram.
                        </p>

                    </div>


                    <div class="maison-savoir-composicao">

                        <!-- O TRAÇO -->

                        <article class="maison-savoir-item maison-savoir-traco">

                            <div class="maison-savoir-imagem">
                                <img src="/uploads/maison-traco.png" alt="O traço">
                            </div>

                            <h3>O TRAÇO</h3>

                            <p>
                                As primeiras ideias ganham forma no papel. Por meio de
                                croquis e estudos minuciosos, proporções, movimentos e
                                detalhes são aperfeiçoados até que o desenho encontre
                                o equilíbrio entre beleza, identidade e elegância.
                            </p>

                        </article>


                        <!-- A INSPIRAÇÃO -->

                        <article class="maison-savoir-item maison-savoir-inspiracao">

                            <div class="maison-savoir-imagem">
                                <img src="/uploads/maison-inspiracao.png" alt="A inspiração">
                            </div>

                            <h3>A INSPIRAÇÃO</h3>

                            <p>
                                Toda criação começa antes do primeiro desenho. Arquitetura,
                                natureza, arte, tecidos e lugares extraordinários formam
                                um universo de referências que define a atmosfera, as
                                formas e a identidade de cada coleção.
                            </p>

                        </article>


                        <!-- A PEDRA -->

                        <article class="maison-savoir-item maison-savoir-pedra">

                            <div class="maison-savoir-imagem">
                                <img src="/uploads/maison-pedra.png" alt="A pedra">
                            </div>

                            <h3>A PEDRA</h3>

                            <p>
                                Cada gema é observada individualmente e escolhida por
                                suas características únicas. Cor, pureza, lapidação,
                                proporção e raridade orientam uma seleção criteriosa,
                                na qual a pedra muitas vezes determina o próprio
                                caminho da criação.
                            </p>

                        </article>


                        <!-- A CRIAÇÃO -->

                        <article class="maison-savoir-item maison-savoir-criacao">

                            <div class="maison-savoir-imagem">
                                <img src="/uploads/maison-criacao.png" alt="A criação">
                            </div>

                            <h3>A CRIAÇÃO</h3>

                            <p>
                                É pelas mãos do artesão que o desenho se transforma em
                                joia. Metais preciosos são trabalhados, pedras são
                                posicionadas e cada acabamento é executado com precisão,
                                unindo técnicas tradicionais à identidade contemporânea
                                da VoieHaute.
                            </p>

                        </article>

                    </div>

                </section>

                <!-- =================================================
     A RARIDADE COMO MATÉRIA-PRIMA
================================================== -->

                <section class="maison-materias">

                    <div class="maison-materias-cabecalho">

                        <div class="maison-materias-eyebrow">
                            <span></span>
                            <p>LES MATIÈRES</p>
                            <span></span>
                        </div>

                        <h2>A Raridade Como Matéria-Prima</h2>

                        <p>
                            Uma abertura com uma imagem macro grande, reunindo as principais pedras e os metais da
                            VoieHaute.
                        </p>

                    </div>

                    <div class="maison-materias-grid">

                        <!-- METAIS PRECIOSOS -->

                        <article class="maison-materias-item">

                            <div class="maison-materias-imagem">
                                <img src="/uploads/maison-metais.png" alt="Metais preciosos">
                            </div>

                            <h3>METAIS PRECIOSOS</h3>

                            <p>
                                Ouro Amarelo 18k · Ouro Branco 18k ·<br>
                                Ouro Rosé 18k · Platina 950
                            </p>

                        </article>


                        <!-- PEDRAS EXCEPCIONAIS -->

                        <article class="maison-materias-item">

                            <div class="maison-materias-imagem">
                                <img src="/uploads/maison-pedras.png" alt="Pedras excepcionais">
                            </div>

                            <h3>PEDRAS EXCEPCIONAIS</h3>

                            <p>
                                Diamantes · Rubis · Esmeraldas · Safiras ·<br>
                                Tanzanitas · Turmalinas Paraíba
                            </p>

                        </article>


                        <!-- A ESCOLHA -->

                        <article class="maison-materias-item">

                            <div class="maison-materias-imagem">
                                <img src="/uploads/maison-escolha.jpg" alt="A escolha das matérias-primas">
                            </div>

                            <h3>A ESCOLHA</h3>

                            <p>
                                A seleção de cada matéria-prima é guiada pela beleza,
                                qualidade, raridade e pela forma como ela se integra
                                à identidade de cada criação.
                            </p>

                        </article>

                    </div>

                </section>

                <!-- =================================================
     LUXO COM RESPONSABILIDADE
================================================== -->

                <section class="maison-engagement">

                    <div class="maison-engagement-cabecalho">

                        <div class="maison-engagement-eyebrow">
                            <span></span>
                            <p>NOTRE ENGAGEMENT</p>
                            <span></span>
                        </div>

                        <h2>Luxo Com Responsabilidade</h2>

                        <p>
                            Criar para permanecer também significa pensar além do presente.
                            Para a VoieHaute, a excelência não está apenas na beleza de uma joia,
                            mas também nas escolhas que acompanham sua criação.
                            <br>
                            Nosso compromisso é construir uma visão de luxo em que qualidade,
                            permanência e responsabilidade caminhem juntas — preservando a
                            sofisticação da alta joalheria enquanto buscamos decisões mais
                            conscientes em cada etapa.
                        </p>

                    </div>


                    <!-- IMAGEM PRINCIPAL -->

                    <div class="maison-engagement-principal">
                        <img src="/uploads/maison-responsabilidade.jpg" alt="Luxo com responsabilidade">
                    </div>


                    <!-- TRÊS PILARES -->

                    <div class="maison-engagement-grid">

                        <!-- 01 -->
                        <div class="maison-engagement-card">
                            <img src="/uploads/maison-origem.jpg" alt="Origem responsável">

                            <div class="maison-engagement-overlay">
                                <h4>A EXCELÊNCIA COMEÇA<br>NA ORIGEM</h4>

                                <p>
                                    Cada etapa começa pela escolha de uma matéria-prima.
                                    A VoieHaute prioriza uma seleção rigorosa de fornecedores
                                    e materiais que unem qualidade, raridade e respeito
                                    pelos processos que envolvem sua origem.
                                </p>

                                <p>
                                    Mais do que escolher pedras extraordinárias, buscamos
                                    compreender sua procedência e valorizar decisões que
                                    estejam alinhadas aos princípios da Maison.
                                </p>
                            </div>
                        </div>


                        <!-- 02 -->
                        <div class="maison-engagement-card">
                            <img src="/uploads/maison-permanecer.jpg" alt="Criações para permanecer">

                            <div class="maison-engagement-overlay">
                                <h4>O VERDADEIRO LUXO<br>É AQUILO QUE PERMANECE</h4>

                                <p>
                                    Na VoieHaute, uma joia não é criada para acompanhar
                                    uma tendência passageira. Cada peça nasce de um
                                    processo cuidadoso, pensado para unir beleza,
                                    qualidade e significado.
                                </p>

                                <p>
                                    Criamos joias destinadas a atravessar gerações e
                                    permanecer relevantes ao longo do tempo — peças que
                                    carregam histórias e podem se transformar em
                                    verdadeiros legados.
                                </p>
                            </div>
                        </div>


                        <!-- 03 -->
                        <div class="maison-engagement-card">
                            <img src="/uploads/maison-embalagens.jpg" alt="Embalagens conscientes">

                            <div class="maison-engagement-overlay">
                                <h4>SOFISTICAÇÃO SEM<br>EXCESSOS</h4>

                                <p>
                                    A experiência VoieHaute continua além da joia.
                                    Nossas embalagens são pensadas para unir proteção,
                                    durabilidade e elegância, evitando excessos
                                    desnecessários.
                                </p>

                                <p>
                                    Materiais duráveis e escolhas mais conscientes
                                    preservam a experiência de luxo sem comprometer
                                    aquilo que realmente importa.
                                </p>
                            </div>
                        </div>

                    </div>

                </section>

        </main>


        <%- include('partials/footer') %>


            <!-- =================================================
         TIMELINE PELO SCROLL
    ================================================== -->

            <script>
                document.addEventListener('DOMContentLoaded', () => {

                    const historia = document.querySelector('.maison-historia');
                    const timelineWrapper = document.querySelector('.maison-timeline-wrapper');
                    const anos = document.querySelectorAll('.maison-ano');
                    const marcos = document.querySelectorAll('.maison-marco');

                    if (!historia || !timelineWrapper) return;


                    /* =========================================
                       FIXAR TIMELINE
                    ========================================= */

                    function controlarTimeline() {

                        const historiaRect = historia.getBoundingClientRect();
                        const savoir = document.querySelector('.maison-savoir');
                        const savoirRect = savoir.getBoundingClientRect();

                        const alturaTimeline = timelineWrapper.offsetHeight;

                        /* AINDA NÃO CHEGOU NA HISTÓRIA */
                        if (historiaRect.top > 0) {

                            timelineWrapper.classList.remove('timeline-fixa');
                            timelineWrapper.classList.remove('timeline-final');
                            timelineWrapper.style.display = '';

                            return;
                        }

                        /* CHEGOU EM DO PRIMEIRO TRAÇO À JOIA */
                        if (savoirRect.top <= alturaTimeline) {

                            timelineWrapper.classList.remove('timeline-fixa');
                            timelineWrapper.classList.remove('timeline-final');
                            timelineWrapper.style.display = 'none';

                            return;
                        }

                        /* ESTÁ ENTRE 2016 E 2026 */
                        timelineWrapper.style.display = '';
                        timelineWrapper.classList.add('timeline-fixa');
                        timelineWrapper.classList.remove('timeline-final');
                    }


                    /* =========================================
                       ATIVAR ANO
                    ========================================= */

                    function ativarAno(anoAtual) {

                        anos.forEach(ano => {

                            if (ano.dataset.ano === anoAtual) {
                                ano.classList.add('ativo');
                            } else {
                                ano.classList.remove('ativo');
                            }

                        });

                    }


                    /* =========================================
                       DESCOBRIR QUAL SEÇÃO ESTÁ NA TELA
                    ========================================= */

                    function controlarAno() {

                        const pontoAtivacao = window.innerHeight * 0.45;

                        let anoAtual = null;

                        marcos.forEach(marco => {

                            const rect = marco.getBoundingClientRect();

                            if (
                                rect.top <= pontoAtivacao &&
                                rect.bottom > pontoAtivacao
                            ) {
                                anoAtual = marco.dataset.ano;
                            }

                        });

                        if (anoAtual) {
                            ativarAno(anoAtual);
                        }

                    }


                    /* =========================================
                       SCROLL
                    ========================================= */

                    function atualizar() {
                        controlarTimeline();
                        controlarAno();
                    }

                    window.addEventListener('scroll', atualizar);

                    window.addEventListener('resize', atualizar);

                    atualizar();

                });
            </script>

</body>

</html>