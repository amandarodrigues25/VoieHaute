
<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Criar Conta | VoieHaute</title>

    <link rel="stylesheet" href="/css/autenticacao.css">

    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;500;600&family=Montserrat:wght@300;400;500;600&display=swap" rel="stylesheet">
</head>

<body>

<main class="auth-layout auth-layout-cadastro">

    <!-- BANNER ESQUERDO -->
    <section
        class="auth-visual auth-visual-cadastro"
        aria-label="Faça parte desta história — VoieHaute">
    </section>

    <!-- FORMULÁRIO -->
    <section class="auth-painel auth-painel-cadastro">

        <div class="auth-conteudo">

            <!-- IDENTIDADE VISUAL -->
            <a href="/" class="auth-marca"
               aria-label="VoieHaute — Página inicial">

                <img
                    src="/uploads/logo.png"
                    alt="Pavão dourado VoieHaute"
                    class="auth-logo"
                >

                <span class="auth-nome-marca">
                    VOIEHAUTE
                </span>

                <span class="auth-submarca">
                    JOAILLERIE DE LUXE
                </span>

                <div class="auth-ornamento" aria-hidden="true">
                    <span class="auth-ornamento-linha"></span>
                    <span class="auth-ornamento-estrela">✦</span>
                    <span class="auth-ornamento-linha"></span>
                </div>

            </a>

            <!-- MENSAGEM DE ERRO -->
            <% if (typeof erro !== 'undefined' && erro) { %>
                <div class="auth-erro" role="alert">
                    <%= erro %>
                </div>
            <% } %>

            <!-- FORMULÁRIO DE CADASTRO -->
            <form
                action="/cliente/cadastro"
                method="POST"
                class="auth-formulario"
                id="formCadastro"
            >

                <!-- NOME -->
                <div class="auth-campo">
                    <label for="nome">Nome completo</label>

                    <input
                        type="text"
                        id="nome"
                        name="nome"
                        placeholder="Digite seu nome completo"
                        value="<%= typeof dados !== 'undefined' ? (dados.nome || '') : '' %>"
                        autocomplete="name"
                        required
                    >
                </div>

                <!-- CPF -->
                <div class="auth-campo">
                    <label for="cpf">CPF</label>

                    <input
                        type="text"
                        id="cpf"
                        name="cpf"
                        placeholder="000.000.000-00"
                        value="<%= typeof dados !== 'undefined' ? (dados.cpf || '') : '' %>"
                        inputmode="numeric"
                        maxlength="14"
                        required
                    >
                </div>

                <!-- NASCIMENTO -->
                <div class="auth-campo">
                    <label for="nascimento">Data de nascimento</label>

                    <input
                        type="date"
                        id="nascimento"
                        name="nascimento"
                        value="<%= typeof dados !== 'undefined' ? (dados.nascimento || '') : '' %>"
                        autocomplete="bday"
                        required
                    >
                </div>

                <!-- EMAIL -->
                <div class="auth-campo">
                    <label for="email">E-mail</label>

                    <input
                        type="email"
                        id="email"
                        name="email"
                        placeholder="seu@email.com"
                        value="<%= typeof dados !== 'undefined' ? (dados.email || '') : '' %>"
                        autocomplete="email"
                        required
                    >
                </div>

                <!-- TELEFONE -->
                <div class="auth-campo">
                    <label for="telefone">Telefone com DDD</label>

                    <input
                        type="tel"
                        id="telefone"
                        name="telefone"
                        placeholder="(00) 00000-0000"
                        value="<%= typeof dados !== 'undefined' ? (dados.telefone || '') : '' %>"
                        autocomplete="tel"
                        maxlength="15"
                        required
                    >
                </div>

                <!-- SENHA -->
                <div class="auth-campo">
                    <label for="senha">Senha</label>

                    <div class="auth-senha-wrapper">

                        <input
                            type="password"
                            id="senha"
                            name="senha"
                            placeholder="Digite sua senha"
                            autocomplete="new-password"
                            minlength="8"
                            required
                        >

                        <button
                            type="button"
                            class="auth-mostrar-senha"
                            data-alvo="senha"
                            aria-label="Mostrar senha"
                            aria-pressed="false"
                        >
                            <svg viewBox="0 0 24 24"
                                 fill="none"
                                 stroke="currentColor"
                                 stroke-width="1.5"
                                 stroke-linecap="round"
                                 stroke-linejoin="round"
                                 aria-hidden="true">
                                <path d="M2 12s3.6-6 10-6 10 6 10 6-3.6 6-10 6S2 12 2 12Z"/>
                                <circle cx="12" cy="12" r="3"/>
                                <path class="auth-olho-risco" d="M3 3l18 18"/>
                            </svg>
                        </button>

                    </div>
                </div>

                <!-- CONFIRMAR SENHA -->
                <div class="auth-campo">
                    <label for="confirmarSenha">
                        Confirmar senha
                    </label>

                    <div class="auth-senha-wrapper">

                        <input
                            type="password"
                            id="confirmarSenha"
                            name="confirmarSenha"
                            placeholder="Digite sua senha novamente"
                            autocomplete="new-password"
                            minlength="8"
                            required
                        >

                        <button
                            type="button"
                            class="auth-mostrar-senha"
                            data-alvo="confirmarSenha"
                            aria-label="Mostrar senha"
                            aria-pressed="false"
                        >
                            <svg viewBox="0 0 24 24"
                                 fill="none"
                                 stroke="currentColor"
                                 stroke-width="1.5"
                                 stroke-linecap="round"
                                 stroke-linejoin="round"
                                 aria-hidden="true">
                                <path d="M2 12s3.6-6 10-6 10 6 10 6-3.6 6-10 6S2 12 2 12Z"/>
                                <circle cx="12" cy="12" r="3"/>
                                <path class="auth-olho-risco" d="M3 3l18 18"/>
                            </svg>
                        </button>

                    </div>
                </div>

                <!-- TERMOS -->
                <label class="auth-termos">
                    <input
                        type="checkbox"
                        name="termos"
                        required
                    >

                    <span>
                        Li e concordo com os Termos de Uso e a
                        Política de Privacidade da VoieHaute.
                    </span>
                </label>

                <!-- CRIAR CONTA -->
                <button
                    type="submit"
                    class="auth-botao-principal"
                >
                    CRIAR CONTA
                </button>

            </form>

            <!-- FAZER LOGIN -->
            <a
                href="/cliente/login"
                class="auth-botao-secundario"
            >
                FAZER LOGIN
            </a>

        </div>

    </section>

</main>

<script>
/* ============================================
   MOSTRAR / OCULTAR SENHAS
   ============================================ */

document.querySelectorAll('.auth-mostrar-senha').forEach(botao => {
    const campo = document.getElementById(botao.dataset.alvo);

    if (!campo) return;

    const atualizarOlho = () => {
        const senhaOculta = campo.type === 'password';

        botao.classList.toggle('senha-oculta', senhaOculta);
        botao.setAttribute(
            'aria-label',
            senhaOculta ? 'Mostrar senha' : 'Ocultar senha'
        );
        botao.setAttribute('aria-pressed', String(!senhaOculta));
    };

    atualizarOlho();

    botao.addEventListener('click', () => {
        campo.type = campo.type === 'password'
            ? 'text'
            : 'password';

        atualizarOlho();
    });
});

/* ============================================
   MÁSCARA DE CPF
   ============================================ */

const cpf = document.getElementById('cpf');

cpf.addEventListener('input', () => {
    let valor = cpf.value.replace(/\D/g, '').slice(0, 11);

    valor = valor.replace(/^(\d{3})(\d)/, '$1.$2');
    valor = valor.replace(/^(\d{3})\.(\d{3})(\d)/, '$1.$2.$3');
    valor = valor.replace(/\.(\d{3})(\d)/, '.$1-$2');

    cpf.value = valor;
});

/* ============================================
   MÁSCARA DE TELEFONE
   ============================================ */

const telefone = document.getElementById('telefone');

telefone.addEventListener('input', () => {
    const numeros = telefone.value.replace(/\D/g, '').slice(0, 11);

    if (numeros.length <= 2) {
        telefone.value = numeros.length
            ? '(' + numeros
            : '';
        return;
    }

    const ddd = '(' + numeros.slice(0, 2) + ') ';
    const restante = numeros.slice(2);

    if (numeros.length <= 10) {
        telefone.value = ddd +
            restante.replace(/^(\d{4})(\d+)/, '$1-$2');
    } else {
        telefone.value = ddd +
            restante.replace(/^(\d{5})(\d+)/, '$1-$2');
    }
});

/* ============================================
   CONFERÊNCIA DE SENHAS
   ============================================ */

const senha = document.getElementById('senha');
const confirmarSenha = document.getElementById('confirmarSenha');

function validarSenhas() {
    if (confirmarSenha.value &&
        senha.value !== confirmarSenha.value) {
        confirmarSenha.setCustomValidity(
            'As senhas não coincidem.'
        );
    } else {
        confirmarSenha.setCustomValidity('');
    }
}

senha.addEventListener('input', validarSenhas);
confirmarSenha.addEventListener('input', validarSenhas);
</script>

</body>
</html>
