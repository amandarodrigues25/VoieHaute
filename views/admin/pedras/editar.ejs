<%- include('../partials/header') %>
<%- include('../partials/menu') %>


<main class="admin-form">

    <!-- CAMINHO -->
    <div class="form-caminho">
        <span>Pedras</span>
        <span>›</span>
        <span>Editar Pedra</span>
    </div>


    <!-- TÍTULO -->
    <div class="form-titulo">

        <img
            src="/uploads/Admin/diamante(mais escura).png"
            class="form-titulo-icone"
            alt=""
        >

        <div>

            <h1>Editar Pedra</h1>

            <p>
                Atualize as informações da pedra.
            </p>

        </div>

    </div>


    <!-- FORMULÁRIO -->
    <form
        action="/admin/pedras/editar/<%= pedra.id %>"
        method="POST"
        enctype="multipart/form-data"
        class="form-admin"
    >

        <!-- NOME -->
        <div class="campo-admin">

            <label for="nome">
                Nome da Pedra
            </label>

            <input
                type="text"
                id="nome"
                name="nome"
                value="<%= pedra.nome %>"
                required
            >

        </div>


        <!-- DESCRIÇÃO -->
        <div class="campo-admin campo-admin-espaco">

            <label for="descricao">
                Descrição
            </label>

            <textarea
                id="descricao"
                name="descricao"
                class="textarea-cadastro"
                placeholder="Digite a descrição da pedra..."
            ><%= pedra.descricao || '' %></textarea>

        </div>


        <!-- IMAGEM -->
        <div class="campo-admin campo-admin-espaco campo-imagem">

            <label>
                Imagem da Pedra
            </label>

            <input
                type="file"
                id="imagem"
                name="imagem"
                accept="image/*"
            >

            <label for="imagem" class="upload-produto">

                <% if (pedra.imagem) { %>

                    <!-- IMAGEM ATUAL -->
                    <img
                        src="/uploads/<%= pedra.imagem %>"
                        id="previewImagem"
                        class="preview-imagem preview-imagem-editar"
                        alt="Imagem da pedra"
                    >

                    <!-- ÍCONE PARA TROCAR A IMAGEM -->
                    <span class="editar-imagem-icone">
                        <i class="bi bi-pencil"></i>
                    </span>

                <% } else { %>

                    <!-- CASO A PEDRA AINDA NÃO TENHA IMAGEM -->
                    <div
                        class="upload-conteudo"
                        id="uploadConteudo"
                    >

                        <i class="bi bi-cloud-arrow-up"></i>

                        <span>
                            Clique para selecionar uma imagem
                        </span>

                    </div>

                    <img
                        id="previewImagem"
                        class="preview-imagem"
                        alt="Pré-visualização da imagem"
                    >

                <% } %>

            </label>

        </div>


        <!-- BOTÕES -->
        <div class="form-acoes">

            <a
                href="/admin/pedras"
                class="btn-form-cancelar"
            >
                CANCELAR
            </a>

            <button
                type="submit"
                class="btn-form-salvar"
            >
                SALVAR ALTERAÇÃO
            </button>

        </div>

    </form>

</main>


<script>

    const inputImagem = document.getElementById('imagem');
    const previewImagem = document.getElementById('previewImagem');
    const uploadConteudo = document.getElementById('uploadConteudo');

    inputImagem.addEventListener('change', function () {

        const arquivo = this.files[0];

        if (arquivo) {

            previewImagem.src = URL.createObjectURL(arquivo);
            previewImagem.style.display = 'block';

            if (uploadConteudo) {
                uploadConteudo.style.display = 'none';
            }

        }

    });

</script>


<%- include('../partials/footer') %>