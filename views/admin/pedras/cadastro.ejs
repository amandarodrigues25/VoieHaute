<%- include('../partials/header') %>
<%- include('../partials/menu') %>


<main class="admin-form">

    <!-- CAMINHO -->
    <div class="form-caminho">
        <span>Pedras</span>
        <span>›</span>
        <span>Nova Pedra</span>
    </div>


    <!-- TÍTULO -->
    <div class="form-titulo">

        <img
            src="/uploads/Admin/diamante(mais escura).png"
            class="form-titulo-icone"
            alt=""
        >

        <div>

            <h1>Pedras</h1>

            <p>
                Preencha as informações para adicionar uma nova pedra.
            </p>

        </div>

    </div>


    <!-- FORMULÁRIO -->
    <form
        action="/admin/pedras/cadastrar"
        method="POST"
        class="form-admin"
    >

        <!-- NOME -->
        <div class="campo-admin">

            <label for="nome">
                Nome da Pedra
            </label>

            <input
                type="text"
                id="nome"
                name="nome"
                placeholder="Digite o nome da pedra"
                required
            >

        </div>


        <!-- DESCRIÇÃO -->
        <div class="campo-admin campo-admin-espaco">

            <label for="descricao">
                Descrição
            </label>

            <textarea
                id="descricao"
                name="descricao"
                class="textarea-cadastro"
                placeholder="Digite a descrição da pedra..."
            ></textarea>

        </div>


        <!-- BOTÕES -->
        <div class="form-acoes">

            <a
                href="/admin/pedras"
                class="btn-form-cancelar"
            >
                CANCELAR
            </a>


            <button
                type="submit"
                class="btn-form-salvar"
            >
                CADASTRAR
            </button>

        </div>

    </form>

</main>


<%- include('../partials/footer') %>